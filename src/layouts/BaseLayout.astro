---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { CARD, cardUrl } from '../lib/og';
import { site } from '../data/site';
import { settings } from '../data/cms';

interface Props {
	title?: string;
	/** Shown under the title in search results and link previews. */
	description?: string;
	/** Link preview card, from cardUrl(). */
	image?: string;
	/** Selector of a big logo on the page, like the hero's; the header's eagle waits until its eagle has scrolled away. */
	heroLogo?: string;
}

const {
	title = 'Venkra',
	description = site.description,
	image = cardUrl('home'),
	heroLogo,
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
// The two palettes from the CMS: color_bg becomes --dark-bg and color_light_bg
// --light-bg. global.css picks one by the theme and builds the rest from it.
const palettes = Object.entries(settings)
	.filter(([key]) => key.startsWith('color_'))
	.map(([key, value]) => {
		const role = key.slice('color_'.length);
		return role.startsWith('light_') ? `--light-${role.slice('light_'.length)}: ${value};` : `--dark-${role}: ${value};`;
	})
	.join(' ');
---

<html lang="es-CO">
	<head>
		<ClientRouter />
		<script>
			import '../lib/pageCache';
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content={settings.color_bg} />
		<meta name="color-scheme" content="dark light" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Venkra" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={CARD.width} />
		<meta property="og:image:height" content={CARD.height} />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<slot name="head" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />
		<style is:inline set:html={`:root { ${palettes} }`} />
		<script is:inline>
			// Light or dark: the visitor's pick from the header, else the system's.
			// Runs before the first paint, and again after each client navigation,
			// which resets <html>'s attributes.
			(() => {
				const apply = () => {
					let pick;
					try {
						pick = localStorage.getItem('theme');
					} catch {}
					document.documentElement.dataset.theme = pick || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				};
				apply();
				document.addEventListener('astro:after-swap', apply);
			})();
		</script>
	</head>
	<body data-hero-logo={heroLogo}>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
