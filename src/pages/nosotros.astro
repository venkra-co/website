---
import PageLayout from '../layouts/PageLayout.astro';
import { page } from '../data/cms';
import { markdown } from '../lib/markdown';

const { title, description, eyebrow, body } = page('nosotros');
---

<PageLayout title={title} description={description} eyebrow={eyebrow}>
	<Fragment set:html={markdown(body ?? '')} />
	<a class="stamp" href="/catalogo">Ver el catálogo</a>
</PageLayout>
