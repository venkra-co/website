---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import CatalogueMosaic from '../components/landing/CatalogueMosaic.astro';
import FeaturedDrop from '../components/landing/FeaturedDrop.astro';
import Manifesto from '../components/landing/Manifesto.astro';
import Craft from '../components/landing/Craft.astro';
import HowToBuy from '../components/landing/HowToBuy.astro';
import InstagramStrip from '../components/landing/InstagramStrip.astro';
import Contact from '../components/landing/Contact.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { categories } from '../data/categories';
import { organizationSchema, websiteSchema } from '../lib/seo';
---

<BaseLayout title="Venkra · Camisetas oversized y streetwear en Colombia" heroLogo=".hero-logo > svg">
	<JsonLd slot="head" data={organizationSchema(Astro.site!)} />
	<JsonLd slot="head" data={websiteSchema(Astro.site!)} />
	<link slot="head" rel="preload" href="/hero/poster.webp" as="image" type="image/webp" fetchpriority="high" />
	<main>
		<Hero />
		<CatalogueMosaic categories={categories} />
		<FeaturedDrop />
		<Manifesto />
		<Craft />
		<HowToBuy />
		<InstagramStrip />
		<Contact />
	</main>
</BaseLayout>
