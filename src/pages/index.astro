---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import CatalogueMosaic from '../components/landing/CatalogueMosaic.astro';
import FeaturedDrop from '../components/landing/FeaturedDrop.astro';
import Manifesto from '../components/landing/Manifesto.astro';
import Craft from '../components/landing/Craft.astro';
import HowToBuy from '../components/landing/HowToBuy.astro';
import InstagramStrip from '../components/landing/InstagramStrip.astro';
import Contact from '../components/landing/Contact.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { categories } from '../data/categories';
import { organizationSchema, websiteSchema } from '../lib/seo';
import { page, sections } from '../data/cms';

const { title, description } = page('inicio');
// The sections the CMS shows under the hero, in its order. "marca" is the
// manifesto followed by the details.
const shown = sections.filter((section) => section.visible);
---

<BaseLayout title={title} description={description} heroLogo=".hero-logo > svg">
	<JsonLd slot="head" data={organizationSchema(Astro.site!)} />
	<JsonLd slot="head" data={websiteSchema(Astro.site!)} />
	<link slot="head" rel="preload" href="/hero/poster.webp" as="image" type="image/webp" fetchpriority="high" />
	<main>
		<Hero />
		{shown.map(({ id, content }) => {
			if (id === 'catalogo') return <CatalogueMosaic categories={categories} content={content} />;
			if (id === 'destacados') return <FeaturedDrop content={content} />;
			if (id === 'marca') return [<Manifesto content={content} />, <Craft content={content} />];
			if (id === 'como-comprar') return <HowToBuy content={content} />;
			if (id === 'instagram') return <InstagramStrip content={content} />;
			if (id === 'contacto') return <Contact content={content} />;
		})}
	</main>
</BaseLayout>
