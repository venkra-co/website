---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBlock from '../../components/catalogue/CategoryBlock.astro';
import { categories } from '../../data/categories';
import { products } from '../../data/products';
import { page } from '../../data/cms';

const { title, description } = page('catalogo');
---

<BaseLayout title={`${title} · Venkra`} description={description}>
	<main class="section catalogue">
		<header class="section-head">
			<h1 class="section-title">{title}</h1>
			<p class="eyebrow">{categories.length} líneas · {products.length} prendas</p>
		</header>
		<div class="lines">
			{categories.map((category, i) => (
				<CategoryBlock category={category} index={i + 1} />
			))}
		</div>
	</main>
</BaseLayout>

<style>
	.catalogue {
		padding-top: calc(var(--header-height) + clamp(3rem, 6vw, 5rem));
	}

	.lines {
		display: grid;
		gap: 4px;
	}
</style>
