---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBlock from '../../components/catalogue/CategoryBlock.astro';
import { categories } from '../../data/categories';
import { products } from '../../data/products';
---

<BaseLayout
	title="Catálogo · Venkra"
	description="Todas las líneas de Venkra: camisetas oversized Over Smoke y Over Qtar, y gorras trucker. Precios en pesos y pedidos por WhatsApp."
>
	<main class="section catalogue">
		<header class="section-head">
			<h1 class="section-title">Catálogo</h1>
			<p class="eyebrow">{categories.length} líneas · {products.length} prendas</p>
		</header>
		<div class="lines">
			{categories.map((category, i) => (
				<CategoryBlock category={category} index={i + 1} />
			))}
		</div>
	</main>
</BaseLayout>

<style>
	.catalogue {
		padding-top: calc(var(--header-height) + clamp(3rem, 6vw, 5rem));
	}

	.lines {
		display: grid;
		gap: 4px;
	}
</style>
