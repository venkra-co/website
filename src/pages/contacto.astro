---
import PageLayout from '../layouts/PageLayout.astro';
import WhatsApp from '../assets/icons/whatsapp.svg';
import { site } from '../data/site';
import { page } from '../data/cms';
---

<PageLayout page={page('contacto')}>
	<div class="channels">
		<a class="stamp cta" href={site.whatsapp} target="_blank" rel="noopener">
			<WhatsApp aria-hidden="true" />
			<span>WhatsApp</span>
		</a>
		<a class="stamp" href={site.instagram} target="_blank" rel="noopener">Instagram</a>
		<a class="stamp" href={site.messenger} target="_blank" rel="noopener">Messenger</a>
	</div>
</PageLayout>

<style>
	.channels {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		--stamp-size: 2.75rem;
	}
</style>
