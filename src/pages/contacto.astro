---
import PageLayout from '../layouts/PageLayout.astro';
import WhatsApp from '../assets/icons/whatsapp.svg';
import { site } from '../data/site';
import { page } from '../data/cms';

// The other contacts set in the CMS; an empty one is left out.
const channels = [
	{ label: 'Instagram', href: site.instagram },
	{ label: 'Facebook', href: site.facebook },
	{ label: 'Messenger', href: site.messenger },
	{ label: site.email, href: site.email && `mailto:${site.email}` },
].filter((channel) => channel.href);
---

<PageLayout page={page('contacto')}>
	<div class="channels">
		<a class="stamp cta" href={site.whatsapp} target="_blank" rel="noopener">
			<WhatsApp aria-hidden="true" />
			<span>WhatsApp</span>
		</a>
		{channels.map((channel) => (
			<a class="stamp" href={channel.href} target="_blank" rel="noopener">{channel.label}</a>
		))}
	</div>
</PageLayout>

<style>
	.channels {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		--stamp-size: 2.75rem;
	}
</style>
