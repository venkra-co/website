---
import Eagle from '../../assets/eagle.svg';
import Instagram from '../../assets/icons/instagram.svg';
import WhatsApp from '../../assets/icons/whatsapp.svg';
import { site } from '../../data/site';
import { padIndex } from '../../lib/format';

const { links, support, tagline, credit } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="main">
		<a class="brand" href="/" aria-label="Venkra, inicio">
			<Eagle aria-hidden="true" />
			<span class="wordmark" aria-hidden="true">Venkra</span>
		</a>
		<p class="tagline">{tagline}</p>
		<div class="links">
			<nav class="pages" aria-label="Pie de página">
				{links.map((link, i) => (
					<a class="stamp page" href={link.href}><span class="num">{padIndex(i + 1)}</span>{link.label}</a>
				))}
			</nav>
			<a class="stamp icon" href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram">
				<Instagram aria-hidden="true" />
			</a>
			<a class="stamp cta" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
				<WhatsApp aria-hidden="true" />
				<span>Escríbenos</span>
			</a>
		</div>
	</div>
	<nav class="support" aria-label="Ayuda">
		{support.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>
	<div class="legal">
		<p>© {year} Venkra<span class="legal-tagline"> · {tagline}</span><span class="legal-rights">. Todos los derechos reservados.</span></p>
		<a href={credit.href} target="_blank" rel="noopener">{credit.label}</a>
	</div>
</footer>

<style>
	/* Desktop: the eagle and tagline centred over a row of stamped tags, like the
	   header's. Mobile: one compact block with the eagle and Instagram on top. */
	.site-footer {
		--stamp-size: 2.75rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 4.5rem var(--page-gutter) 0;
		border-top: 1px solid var(--color-line);
		box-sizing: border-box;
	}

	.main {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: var(--color-fg);
		text-decoration: none;
	}

	.brand :global(svg) {
		display: block;
		width: 7.5rem;
		height: auto;
	}

	.wordmark {
		display: none;
		font: 700 1rem/1 var(--font-display);
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}

	.tagline {
		margin: 0;
		color: var(--color-muted);
		font: 700 0.875rem/1.4 var(--font-display);
		letter-spacing: 0.32em;
		text-align: center;
		text-transform: uppercase;
	}

	.links,
	.pages {
		display: flex;
		gap: 0.75rem;
	}

	.links {
		margin-top: 0.75rem;
	}

	.support {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.75rem;
		margin-top: 2.75rem;
		font-size: 0.875rem;
	}

	.support a,
	.legal a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.support a:hover,
	.legal a:hover {
		color: var(--color-accent);
	}

	.legal {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: 1.5rem;
		padding: 1.25rem 0 1.5rem;
		border-top: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: 0.8125rem;
	}

	.legal p {
		margin: 0;
	}

	.legal-tagline {
		display: none;
	}

	@media (max-width: 760px) {
		.site-footer {
			padding-top: 2rem;
		}

		/* Eagle and Instagram on top, the pages as plain links, then a full-width WhatsApp tag. */
		.main {
			display: grid;
			grid-template-areas:
				'brand icon'
				'pages pages'
				'cta cta';
			align-items: center;
			gap: 1.25rem;
		}

		.links {
			display: contents;
		}

		.brand {
			grid-area: brand;
		}

		.brand :global(svg) {
			width: 3rem;
		}

		.wordmark {
			display: block;
		}

		.tagline,
		.num,
		.legal-rights {
			display: none;
		}

		.pages {
			grid-area: pages;
			gap: 1.75rem;
		}

		.page {
			padding: 0;
			border: 0;
		}

		.page:hover {
			background: transparent;
			color: var(--color-accent);
		}

		.icon {
			grid-area: icon;
			justify-self: end;
		}

		.cta {
			grid-area: cta;
		}

		.support {
			justify-content: flex-start;
			margin-top: 2rem;
		}

		.legal {
			flex-direction: column;
			margin-top: 1.25rem;
			padding: 1rem 0 1.5rem;
			font-size: 0.75rem;
		}

		.legal-tagline {
			display: inline;
		}
	}
</style>
