---
import { padIndex } from '../../lib/format';

interface Props {
	content: { title: string; eyebrow: string; steps: { title: string; text: string }[] };
}

const { content } = Astro.props;
---

<section id="como-comprar" class="section" aria-labelledby="buy-title">
	<header class="section-head">
		<h2 id="buy-title" class="section-title">{content.title}</h2>
		<p class="eyebrow">{content.eyebrow}</p>
	</header>
	<ol class="steps">
		{content.steps.map((step, i) => (
			<li>
				<span class="step-num">{padIndex(i + 1)}</span>
				<h3>{step.title}</h3>
				<p>{step.text}</p>
			</li>
		))}
	</ol>
</section>

<style>
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
	}

	li {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-line-strong);
	}

	.step-num {
		color: var(--color-accent);
		font: 900 clamp(3rem, 6vw, 4.5rem)/0.85 var(--font-display);
	}

	h3 {
		margin: 0;
		font: 900 1.75rem/0.95 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.6;
	}

	@media (max-width: 760px) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
