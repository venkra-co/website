---
import Eagle from '../../assets/eagle.svg';
import WhatsApp from '../../assets/icons/whatsapp.svg';
import { site } from '../../data/site';
---

<section id="escribenos" class="section contact cream" aria-label="Escríbenos">
	<Eagle class="eagle" aria-hidden="true" />
	<p>Pedidos, tallas o dudas. Te respondemos por WhatsApp.</p>
	<a class="stamp cta" href={site.whatsapp} target="_blank" rel="noopener">
		<WhatsApp aria-hidden="true" />
		<span>Abrir WhatsApp</span>
	</a>
</section>

<style>
	/* A cream band: the eagle, one line of text and a black button. */
	.contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		max-width: calc(var(--page-max) - 2 * var(--page-gutter));
		margin-block: clamp(3rem, 6vw, 5rem);
		padding: 2.5rem clamp(1.25rem, 4vw, 3rem);
	}

	.eagle {
		flex: none;
		width: 4.5rem;
		height: auto;
	}

	p {
		flex: 1 1 16rem;
		margin: 0;
		font: 700 1.1rem/1.3 var(--font-display);
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.cta {
		--stamp-size: 2.75rem;
	}
</style>
