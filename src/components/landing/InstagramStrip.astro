---
import { site } from '../../data/site';

interface Props {
	/** Brand shots, each linking to its Instagram post. */
	content: { title: string; button: string; photos: { image: string; alt: string; link: string }[] };
}

const { content } = Astro.props;
---

<section id="instagram" class="section" aria-labelledby="instagram-title">
	<header class="section-head">
		<h2 id="instagram-title" class="section-title">{content.title}</h2>
		{site.instagram && <a class="stamp" href={site.instagram} target="_blank" rel="noopener">{content.button}</a>}
	</header>
	<ul class="photos">
		{content.photos.map((photo) => (
			<li>
				<a href={photo.link} target="_blank" rel="noopener">
					<img src={photo.image} alt={photo.alt} loading="lazy" decoding="async" />
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.section-head {
		align-items: end;
	}

	.photos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 4px;
	}

	img {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		background: var(--color-surface);
	}

	a {
		display: block;
	}

	a:hover img,
	a:focus-visible img {
		opacity: 0.8;
	}

	/* Two rows of three would leave a hole, so scroll the five sideways. */
	@media (max-width: 760px) {
		.photos {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 40%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
		}

		li {
			scroll-snap-align: start;
		}
	}
</style>
