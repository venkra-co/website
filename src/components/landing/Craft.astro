---
import { padIndex } from '../../lib/format';

// Materials and finishes, from the product descriptions in the old site's spreadsheet.
const details = [
	{ title: 'Algodón premium', text: 'Camisetas de 200 g con lavado vintage y corte amplio.' },
	{ title: 'Heavyweight', text: 'Oversize en algodón peinado de 220 a 260 g, con caída firme.' },
	{ title: 'Vinilo 3D', text: 'El logo en vinilo de alta densidad, en relieve que se siente al tacto.' },
	{ title: 'Trucker', text: 'Gorras con frente en foam, malla transpirable y hebilla metálica.' },
];
---

<section id="detalles" class="section" aria-labelledby="craft-title">
	<header class="section-head">
		<h2 id="craft-title" class="section-title">Detalles</h2>
		<p class="eyebrow">Special goods</p>
	</header>
	<ul class="details">
		{details.map((detail, i) => (
			<li>
				<span class="num">{padIndex(i + 1)}</span>
				<h3>{detail.title}</h3>
				<p>{detail.text}</p>
			</li>
		))}
	</ul>
</section>

<style>
	.details {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		border-top: 1px solid var(--color-line-strong);
		border-left: 1px solid var(--color-line-strong);
	}

	li {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		padding: 1.5rem;
		border-right: 1px solid var(--color-line-strong);
		border-bottom: 1px solid var(--color-line-strong);
	}

	h3 {
		margin: 1.5rem 0 0;
		font: 900 1.75rem/0.95 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.6;
	}

	@media (max-width: 960px) {
		.details {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.details {
			grid-template-columns: minmax(0, 1fr);
		}

		h3 {
			margin-top: 0.5rem;
		}
	}
</style>
