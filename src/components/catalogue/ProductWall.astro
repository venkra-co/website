---
import type { Product } from '../../data/products';
import { wallSpan } from '../../lib/wall';
import ProductTile from './ProductTile.astro';

interface Props {
	products: readonly Product[];
}

const { products } = Astro.props;
---

<ul class="wall">
	{products.map((product, i) => (
		<li data-d={wallSpan(i, products.length, 3)} data-m={wallSpan(i, products.length, 2)}>
			<ProductTile product={product} />
		</li>
	))}
</ul>

<style>
	/* The first product is a big tile; the spans in data-d (3 columns) and
	   data-m (2 columns) close the wall without holes. */
	.wall {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-auto-rows: clamp(16rem, 24vw, 24rem);
		gap: 4px;
	}

	@media (min-width: 761px) {
		[data-d='big'] {
			grid-column: span 2;
			grid-row: span 2;
		}

		[data-d='tall'] {
			grid-row: span 2;
		}

		[data-d='wide'] {
			grid-column: span 2;
		}

		[data-d='full'] {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 760px) {
		.wall {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: 14rem;
		}

		[data-m='big'] {
			grid-column: span 2;
			grid-row: span 2;
		}

		[data-m='wide'],
		[data-m='full'] {
			grid-column: span 2;
		}
	}
</style>
