---
import type { Category } from '../../data/categories';
import type { Product } from '../../data/products';
import { formatPrice } from '../../lib/format';
import { orderLink } from '../../lib/whatsapp';
import ProductGallery from './ProductGallery.astro';

interface Props {
	product: Product;
	category: Category;
}

const { product, category } = Astro.props;

const { sizes, colors } = product;
// One-size products skip the size picker.
const picker = sizes.length > 1;
const size = sizes[0];
---

<section class="cover" data-cover>
	<button class="frame" type="button" aria-label="Ver fotos en grande" data-open-gallery>
		<img class="photo" src={product.images[0]} alt={product.name} data-photo />
	</button>
	<div class="panel cream">
		<div class="intro">
			<p class="eyebrow">{category.name}</p>
			<h1 class="name">{product.name}</h1>
			<p class="price">{formatPrice(product.price)}</p>
			<ul class="details">
				{product.details.map((detail) => <li>{detail}</li>)}
			</ul>
			{colors.length > 0 && (
				<ul class="colors" aria-label="Colores">
					{colors.map((color) => (
						<li>
							<span class="swatch" style={`background: ${color.hex}`}></span>
							{color.name}
						</li>
					))}
				</ul>
			)}
		</div>
		<div class="order">
			{product.images.length > 1 && (
				<div class="thumbs">
					{product.images.map((src, i) => (
						<button type="button" data-src={src} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Foto ${i + 1}`}>
							<img src={src} alt="" loading="lazy" decoding="async" />
						</button>
					))}
				</div>
			)}
			{picker && (
				<fieldset class="sizes">
					<legend class="eyebrow">Talla</legend>
					{sizes.map((label) => (
						<button
							class="stamp"
							type="button"
							data-size={label}
							data-href={orderLink(product, label)}
							aria-pressed={label === size ? 'true' : 'false'}
						>
							{label}
						</button>
					))}
				</fieldset>
			)}
			<a class="stamp cta" href={orderLink(product, picker ? size : undefined)} target="_blank" rel="noopener" data-cta>
				{picker ? <span>Pedir talla <span data-label>{size}</span> por WhatsApp</span> : 'Pedir por WhatsApp'}
			</a>
		</div>
	</div>
	<ProductGallery images={product.images} name={product.name} />
</section>

<script>
	// Listening on the document once keeps working across client navigations.
	// Thumbs swap the photo; sizes point the order link at the chosen size.
	document.addEventListener('click', (event) => {
		const button = (event.target as Element).closest<HTMLButtonElement>('[data-cover] :is([data-src], [data-size])');
		const cover = button?.closest<HTMLElement>('[data-cover]');
		if (!button || !cover) return;
		const group = button.dataset.src ? 'data-src' : 'data-size';
		cover.querySelectorAll(`[${group}]`).forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
		if (button.dataset.src) {
			cover.querySelector<HTMLImageElement>('[data-photo]')!.src = button.dataset.src;
		} else {
			const cta = cover.querySelector<HTMLAnchorElement>('[data-cta]')!;
			cta.href = button.dataset.href!;
			cta.querySelector('[data-label]')!.textContent = button.dataset.size!;
		}
	});
</script>

<style>
	.cover {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
	}

	/* Every photo shows in the same 3:2 frame, so switching photos never moves
	   the page; the gallery shows them whole. */
	.frame {
		align-self: start;
		aspect-ratio: 3 / 2;
		padding: 0;
		border: 0;
		background: var(--color-surface);
		cursor: zoom-in;
	}

	/* Beside a longer panel, the photo stays in view. */
	@media (min-width: 761px) {
		.frame {
			position: sticky;
			top: var(--header-height);
		}
	}

	.frame:focus-visible {
		outline: 3px solid var(--color-accent);
		outline-offset: -3px;
	}

	.photo {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.panel {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 2.5rem;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.intro {
		display: grid;
		gap: 1.25rem;
	}

	.name {
		margin: 0;
		font: 900 clamp(3rem, 7vw, 6.5rem)/0.82 var(--font-display);
		font-stretch: condensed;
		text-transform: uppercase;
	}

	.price {
		margin: 0;
		font-size: 1.75rem;
	}

	.details {
		margin: 0;
		padding-left: 1.1rem;
		line-height: 1.6;
	}

	.colors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.colors li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.swatch {
		width: 1.1rem;
		height: 1.1rem;
		border: 1px solid var(--color-line-strong);
	}

	.order {
		display: grid;
		gap: 1rem;
	}

	.thumbs {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
	}

	.thumbs button {
		flex: none;
		width: 3.75rem;
		padding: 0;
		border: 2px solid transparent;
		background: none;
		cursor: pointer;
	}

	.thumbs img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.thumbs [aria-pressed='true'] {
		border-color: var(--color-fg);
	}

	.sizes {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 0;
		padding: 1rem 0 0;
		border: 0;
		border-top: 1px solid var(--color-line);
	}

	.sizes legend {
		float: left;
		grid-column: 1 / -1;
		margin-bottom: 0.5rem;
	}

	.sizes .stamp {
		justify-content: center;
		--stamp-size: 3rem;
	}

	.sizes [aria-pressed='true'] {
		background: var(--color-fg);
		border-color: var(--color-fg);
		color: var(--color-bg);
	}

	.cta {
		--stamp-size: 3.5rem;
		margin: 0;
	}

	@media (max-width: 760px) {
		.cover {
			grid-template-columns: 1fr;
		}
	}
</style>
